[Unit]
Description=Wall calendar display server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=WALLDISPLAY_CONFIG=__DIR__/config.yaml
ExecStart=__DIR__/.venv/bin/python -m uvicorn app.main:app --host __HOST__ --port __PORT__
Restart=always
RestartSec=5

# The server only ever needs its own directory and the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__DIR__

[Install]
WantedBy=multi-user.target
