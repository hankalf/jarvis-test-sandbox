# Required — the brain that answers you.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — image/video rendering. Without it the studio writes local
# placeholder cards so the whole loop still works offline.
FAL_KEY=

# Optional tuning.
# AAL_MODEL=claude-opus-5
# AAL_EFFORT=medium        # low | medium | high | xhigh | max
# AAL_PORT=8420
